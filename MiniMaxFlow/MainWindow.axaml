<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MiniMaxFlow.MainWindow" Width="1040" Height="780" MinWidth="380" MinHeight="480"
        Title="MiniMax Flow — 簽到工作台" Icon="/Assets/icon.png" RequestedThemeVariant="Light">
  <Window.Styles>
    <StyleInclude Source="/WorkspaceStyles.axaml" />
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid x:Name="Header" MaxWidth="1256" Margin="24,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Source="/Assets/icon.png" Width="34" Height="34" />
          <TextBlock Text="MiniMax Flow" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>
        <ListBox x:Name="Navigation" Grid.Column="1" SelectedIndex="0" Classes="nav" VerticalAlignment="Center"
                 AutomationProperties.Name="主要導覽" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBoxItem AutomationProperties.Name="儀表板">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Classes="glyph" Data="M2 2H9V9H2Z M13 2H20V9H13Z M2 13H9V20H2Z M13 13H20V20H13Z" />
              <TextBlock Text="儀表板" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem AutomationProperties.Name="帳號設定">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Classes="glyph" Data="M14 7A4 4 0 1 1 6 7A4 4 0 1 1 14 7 M2 21V19C2 12 18 12 18 19V21 M17 3C22 4 22 10 18 11 M20 15Q23 16 23 20" />
              <TextBlock Text="帳號設定" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem AutomationProperties.Name="登入狀態">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Classes="glyph" Data="M3 10H19V21H3Z M6 10V7A5 5 0 0 1 16 7V10 M11 14V17" />
              <TextBlock Text="登入狀態" />
            </StackPanel>
          </ListBoxItem>
        </ListBox>
      </Grid>
    </Border>
    <ScrollViewer x:Name="PageScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Grid x:Name="PageBody" MaxWidth="1200" Margin="28,22,28,26">
        <StackPanel x:Name="DashboardView" Spacing="16">
          <Border Classes="panel" Background="{DynamicResource BannerBrush}" Padding="0" ClipToBounds="True">
            <Grid>
              <Svg x:Name="CircuitArt" Path="/Assets/check-in-circuit.svg" Width="340" Height="162"
                   IsHitTestVisible="False" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" />
              <StackPanel Margin="24,19" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Classes="title" Text="簽到儀表板" />
                <TextBlock Classes="caption data" Text="huang1988pioneer / AutoSignMiniMax" />
                <WrapPanel Margin="0,9,0,0" ItemSpacing="8" LineSpacing="6">
                  <Button x:Name="TriggerClaimButton" Classes="primary" Click="TriggerClaimButton_OnClick" AutomationProperties.Name="手動執行每日簽到">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Path Classes="glyph" Width="12" Height="12" Data="M4 2L17 10L4 18Z" />
                      <TextBlock Text="執行每日簽到" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="RefreshDashboardButton" Classes="secondary" Click="RefreshDashboardButton_OnClick" AutomationProperties.Name="更新執行結果">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Path Classes="glyph" Width="14" Height="14" Data="M19 8A8 8 0 1 0 19 15 M19 2V8H13" />
                      <TextBlock Text="更新執行結果" />
                    </StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="panel" Padding="0">
            <Grid ColumnDefinitions="*,1,*,1,*">
              <StackPanel Margin="16,14" Spacing="5">
                <TextBlock Classes="caption" Text="最近成功帳號" />
                <TextBlock x:Name="SuccessfulAccountsMetric" Classes="metric" Foreground="{DynamicResource AccentBrush}" Text="—" />
              </StackPanel>
              <Border Grid.Column="1" Background="{DynamicResource LineBrush}" Margin="0,14" />
              <StackPanel Grid.Column="2" Margin="16,14" Spacing="5">
                <TextBlock Classes="caption" Text="連續成功天數" />
                <TextBlock x:Name="ConsecutiveSuccessActionDaysMetric" Classes="metric" Text="—" />
              </StackPanel>
              <Border Grid.Column="3" Background="{DynamicResource LineBrush}" Margin="0,14" />
              <StackPanel Grid.Column="4" Margin="16,14" Spacing="5">
                <TextBlock Classes="caption" Text="本月預估積分" />
                <TextBlock x:Name="MonthlyPointsMetric" Classes="metric" Text="—" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid x:Name="DashboardColumns" ColumnDefinitions="*,270" RowDefinitions="Auto,Auto" ColumnSpacing="16">
            <Border Classes="panel" VerticalAlignment="Top">
              <StackPanel Spacing="14">
                <TextBlock Classes="heading" Text="帳號執行結果" />
                <TextBlock x:Name="DashboardStatusText" Classes="caption" Text="按「更新執行結果」即可查看最近一次簽到。" />
                <Grid x:Name="ResultsHeader" ColumnDefinitions="58,*,*" ColumnSpacing="8" IsVisible="False">
                  <TextBlock Classes="caption" Text="編號" />
                  <TextBlock Grid.Column="1" Classes="caption" Text="帳號別名" />
                  <TextBlock Grid.Column="2" Classes="caption" Text="簽到狀態" />
                </Grid>
                <StackPanel x:Name="ActionAccountResultsPanel" Spacing="0" />
                <Border Classes="divider" />
                <WrapPanel ItemSpacing="30" LineSpacing="10">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="caption" Text="最近成功時間" />
                    <TextBlock x:Name="LastSuccessfulActionMetric" Classes="data" Text="—" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Classes="caption" Text="最近失敗時間" />
                    <TextBlock x:Name="LastFailedActionMetric" Classes="data" Text="—" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border x:Name="SchedulePanel" Grid.Column="1" Classes="panel" VerticalAlignment="Top">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="heading" Text="每日排程" />
                  <TextBlock Grid.Column="1" Classes="caption" Text="台北時間" VerticalAlignment="Center" />
                </Grid>
                <Border Classes="divider" />
                <Grid ColumnDefinitions="48,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="11">
                  <TextBlock Classes="caption" Text="清晨" />
                  <TextBlock Grid.Column="1" Classes="data" Text="05:00" />
                  <TextBlock Grid.Row="1" Classes="caption" Text="上午" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Classes="data" Text="08:00  08:18&#10;09:19  11:00" />
                  <TextBlock Grid.Row="2" Classes="caption" Text="下午" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Classes="data" Text="13:00" />
                  <TextBlock Grid.Row="3" Classes="caption" Text="晚上" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Classes="data" Text="21:00" />
                </Grid>
                <TextBlock Classes="caption" Text="排程觸發後會隨機等待 0–59 分鐘。" />
              </StackPanel>
            </Border>
          </Grid>
          <Expander Header="積分估算與簽到獎勵" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    CornerRadius="12" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Spacing="10">
              <WrapPanel ItemSpacing="10" LineSpacing="6">
                <TextBlock VerticalAlignment="Center" Text="每帳號每日估算點數" />
                <TextBox x:Name="PointsPerClaimTextBox" Width="80" Text="20" AutomationProperties.Name="每帳號每日估算點數" />
              </WrapPanel>
              <TextBlock Classes="caption" Text="更新執行結果後，以此數值估算本月積分。實際獎勵依簽到週期而異。" />
              <Svg Path="/Assets/daily-check-in.svg" MaxWidth="510" Height="245" Stretch="Uniform" HorizontalAlignment="Left"
                   AutomationProperties.Name="七日簽到獎勵範例，連續七天共四千點。" />
            </StackPanel>
          </Expander>
        </StackPanel>

        <StackPanel x:Name="AccountView" Spacing="16" IsVisible="False" MaxWidth="780">
          <StackPanel Spacing="4">
            <TextBlock Classes="title" Text="帳號設定" />
            <TextBlock Classes="caption" Text="為帳號編號設定別名，方便辨識簽到結果與對應的 Secret。" />
          </StackPanel>
          <Border Classes="panel">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="heading" Text="帳號別名" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="primary" Click="SaveAliasesButton_OnClick">儲存帳號別名</Button>
              </Grid>
              <TextBlock x:Name="AliasStatusText" Classes="caption" Text="別名儲存在這台電腦。留白時使用預設帳號編號。" />
              <Border Classes="divider" />
              <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="AliasListPanel" Spacing="6" Margin="0,0,12,0" />
              </ScrollViewer>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="LoginView" Spacing="16" IsVisible="False" MaxWidth="780">
          <StackPanel Spacing="4">
            <TextBlock Classes="title" Text="建立登入狀態" />
            <TextBlock Classes="caption" Text="在瀏覽器完成 MiniMax 登入後，將登入狀態同步至 GitHub Actions。" />
          </StackPanel>
          <Border Classes="panel">
            <StackPanel Spacing="14">
              <TextBlock Classes="heading" Text="選擇帳號" />
              <WrapPanel ItemSpacing="16" LineSpacing="8">
                <ComboBox x:Name="AccountComboBox" Width="130" SelectedIndex="0" AutomationProperties.Name="帳號編號" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock x:Name="AccountAliasText" FontWeight="SemiBold" IsVisible="False" />
                  <TextBlock x:Name="SecretNameText" Classes="caption data" />
                </StackPanel>
              </WrapPanel>
              <Border Classes="divider" />
              <TextBlock Classes="caption" Text="請在新開啟的瀏覽器完成登入與驗證，看到 MiniMax 首頁後關閉該視窗。" />
              <CheckBox x:Name="AutoPublishActionsCheckBox" IsChecked="True" Content="登入完成後自動同步到 GitHub Actions" />
              <Button x:Name="RunFlowButton" Classes="primary" HorizontalAlignment="Left" Click="RunFlowButton_OnClick">開始登入並建立狀態</Button>
            </StackPanel>
          </Border>
          <Border Classes="panel">
            <StackPanel Spacing="12">
              <TextBlock Classes="heading" Text="同步與複製" />
              <TextBlock x:Name="ResultText" Classes="caption" />
              <TextBlock Classes="caption" Text="同步會更新該帳號的 GitHub Secret 與別名。請先在終端機登入 GitHub CLI。" />
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button x:Name="PublishActionsButton" IsEnabled="False" Click="PublishActionsButton_OnClick">同步至 GitHub Actions</Button>
                <Button x:Name="CopyStateButton" IsEnabled="False" Click="CopyStateButton_OnClick">讀取並複製登入狀態</Button>
                <Button x:Name="CopySecretNameButton" IsEnabled="False" Click="CopySecretNameButton_OnClick">複製 Secret 名稱</Button>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Border Grid.Row="2" IsVisible="{Binding IsVisible, ElementName=LoginView}"
            Background="{DynamicResource WashBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
      <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="StatusText" MaxWidth="780" Margin="16,10" Text="準備就緒。"
                   TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" />
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
